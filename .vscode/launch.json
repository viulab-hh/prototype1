{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch App",
			"type": "pwa-chrome",
			"request": "launch",
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "npm: dev"
		},
		{
			"name": "Open app.html",
			"type": "pwa-chrome",
			"request": "launch",
			"file": "${workspaceFolder}/src/app.html",
			"webRoot": "${workspaceFolder}"
		}
	]
}
